{
  "name": "streetskate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm test && npm run verify:physics && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:vert": "node tools/verify-vert.mjs",
    "test:pump": "node tools/verify-pumping.mjs",
    "verify:board": "node tools/verify-board.mjs",
    "verify:physics": "npm run verify:board && npm run test:vert && npm run test:pump"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "vite": "7.3.5" }
}
