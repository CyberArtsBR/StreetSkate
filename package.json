{
  "name": "streetskate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/materialize-textures.mjs && node tools/materialize-music.mjs && vite --host 127.0.0.1",
    "build": "node tools/materialize-textures.mjs && node tools/materialize-music.mjs && vite build",
    "validate": "npm test && npm run verify:physics",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:vert": "node tools/verify-vert.mjs",
    "test:pump": "node tools/verify-pumping.mjs",
    "verify:board": "node tools/verify-board.mjs",
    "verify:physics": "npm run verify:board && npm run test:vert && npm run test:pump"
  },
  "dependencies": {
    "three": "0.180.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "vite": "7.3.5"
  }
}
